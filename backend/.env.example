# --- Obrigatórias ---
# Postgres (Neon/Supabase). No Neon use a string "pooled" (host com -pooler) e ?sslmode=require
DATABASE_URL=postgres://usuario:senha@host/clinica?sslmode=require
# 64+ caracteres aleatórios: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 64 hex (32 bytes): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# GUARDE UMA CÓPIA FORA DO NETLIFY: sem ela, CPF e prontuários cifrados não podem ser recuperados.
ENCRYPTION_KEY=

# --- Sara (IA) ---
ANTHROPIC_API_KEY=sk-ant-...
SARA_MODEL=claude-sonnet-5-5
# Tempo máximo (ms) de uma conversa antes de responder; reduza (ex.: 8000) se o seu plano limitar a função a 10 s
SARA_BUDGET_MS=40000

# --- Serverless ---
# Conexões por instância da função (cada invocação concorrente abre as suas): mantenha baixo
PG_POOL_MAX=3

# --- Google Agenda (console.cloud.google.com > Google Calendar API > credencial OAuth "Web") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# https://SEU-SITE.netlify.app/api/google/callback  (local: http://localhost:3000/google/callback)
GOOGLE_REDIRECT_URI=
# https://SEU-SITE.netlify.app  (local: http://localhost:5173)
APP_URL=

# --- Opcionais ---
# Só se a API for chamada de outra origem (lista separada por vírgula). Em produção no Netlify não é necessário.
CORS_ORIGIN=
PORT=3000
